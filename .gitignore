*.gguf
*.bin
*.safetensors
*.pt
*.onnx
models/

# ─── Captured evidence frames (filesystem-backed, never commit) ──────────────
backend/evidence/
evidence/

# ─── Bundled MediaPipe assets (regenerated by predev script) ─────────────────
frontend/public/mediapipe/

# ─── Local design playgrounds (NOT part of the app) ──────────────────────────
# Scratch workspaces used to prototype standalone pages before porting them
# into frontend/src. The shipped code lives in frontend/ — these are local
# sandboxes with their own node_modules (~850 MB) and must never be pushed.
# Leading slash matters: it anchors to the repo root so the real app code in
# frontend/src/components/landing/ is NOT swept up by this rule.
/instructions/
/landing/

# ─── Tool output / generated artifacts ───────────────────────────────────────
/graphify-out/
/.kilo/


# ─── Personal test data (never commit real resumes) ──────────────────────────
testresume.pdf
*.resume.pdf

# ─── Scratch files ───────────────────────────────────────────────────────────
temp.txt
/d

# Misspelled duplicate of files already served from frontend/public/
/assets/assests/


# ─── Misc ────────────────────────────────────────────────────────────────────
*.tmp
*.bak
*.swp


