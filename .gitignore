# ─── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# ─── Database / Runtime data ─────────────────────────────────────────────────
*.db
*.sqlite3
*.sqlite

# ─── Next.js / Node ──────────────────────────────────────────────────────────
node_modules/
.next/
out/
.vercel/
.turbo/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Next.js build output
/frontend/.next/
/frontend/out/

# ─── Environment variables ───────────────────────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local

# ─── OS / Editor junk ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# VS Code (keep settings.json for team consistency, ignore workspace state)
.vscode/extensions.json
.vscode/*.code-workspace
.history/

# JetBrains IDEs
.idea/
*.iml

# ─── Logs ────────────────────────────────────────────────────────────────────
*.log
logs/

# ─── Ollama / AI model weights ───────────────────────────────────────────────
*.gguf
*.bin
*.safetensors
*.pt
*.onnx
models/

# ─── Captured evidence frames (filesystem-backed, never commit) ──────────────
backend/evidence/
evidence/

# ─── Bundled MediaPipe assets (regenerated by predev script) ─────────────────
frontend/public/mediapipe/

# ─── Local design playgrounds (NOT part of the app) ──────────────────────────
# Scratch workspaces used to prototype standalone pages before porting them
# into frontend/src. The shipped code lives in frontend/ — these are local
# sandboxes with their own node_modules (~850 MB) and must never be pushed.
# Leading slash matters: it anchors to the repo root so the real app code in
# frontend/src/components/landing/ is NOT swept up by this rule.
/instructions/
/landing/

# ─── Conference paper ────────────────────────────────────────────────────────
# LaTeX sources, benchmarks, and build artifacts for the academic paper. Not
# part of the shipped product and should never be committed.
/FOR CONFERENCE PAPER/

# ─── Tool output / generated artifacts ───────────────────────────────────────
/graphify-out/
/.kilo/

# ─── Per-developer AI agent config ───────────────────────────────────────────
# Instructions for whichever assistant a given developer happens to drive the
# repo with. They encode one person's tool and workflow, not how the project is
# built or run, so they stay local — same reasoning as /graphify-out/ above.
.clinerules
.clineignore


# ─── Personal test data (never commit real resumes) ──────────────────────────
testresume.pdf
*.resume.pdf

# ─── Scratch files ───────────────────────────────────────────────────────────
# "/d" and "/0" are not real files — they are junk left by mistyped shell
# redirects (a stray `> d` or `> 0`). Anchored with a leading slash so they can
# never match a legitimately-named file deeper in the tree.
temp.txt
/d
/0

# Misspelled duplicate of files already served from frontend/public/
/assets/assests/


# ─── Misc ────────────────────────────────────────────────────────────────────
*.tmp
*.bak
*.swp


