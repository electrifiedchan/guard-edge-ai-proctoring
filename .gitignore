# ─── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# ─── Database / Runtime data ─────────────────────────────────────────────────
*.db
*.sqlite3
*.sqlite

# SQLite's WAL-mode sidecars: -wal holds committed pages not yet folded back
# into the main file, -shm is the shared-memory index into it. Both are
# recreated on connect and removed on a clean close, so they are live runtime
# state rather than source. Named explicitly because `*.db` above does not match
# them — the extension is ".db-wal", not ".db".
*.db-wal
*.db-shm

# ─── Next.js / Node ──────────────────────────────────────────────────────────
node_modules/
.next/
out/
.vercel/
.turbo/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Next.js build output
/frontend/.next/
/frontend/out/

# ─── Environment variables ───────────────────────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local

# ─── OS / Editor junk ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# VS Code (keep settings.json for team consistency, ignore workspace state)
.vscode/extensions.json
.vscode/*.code-workspace
.history/

# JetBrains IDEs
.idea/
*.iml

# ─── Logs ────────────────────────────────────────────────────────────────────
*.log
logs/

# Transcript written by setup.ps1 on every run. It records the machine it ran
# on — paths, GPU model, package versions — and is the file a user is asked to
# send back when setup fails. Not source, and not the same shape twice, so it
# would collide on every pull. Named explicitly because `*.log` above does not
# match a `.txt` extension.
setup-log.txt

# ─── Ollama / AI model weights ───────────────────────────────────────────────
*.gguf
*.bin
*.safetensors
*.pt
*.onnx
models/

# ─── Captured evidence frames (filesystem-backed, never commit) ──────────────
backend/evidence/
evidence/

# ─── Bundled MediaPipe assets (regenerated by predev script) ─────────────────
frontend/public/mediapipe/

# ─── Local design playgrounds (NOT part of the app) ──────────────────────────
# Scratch workspaces used to prototype standalone pages before porting them
# into frontend/src. The shipped code lives in frontend/ — these are local
# sandboxes with their own node_modules (~850 MB) and must never be pushed.
# Leading slash matters: it anchors to the repo root so the real app code in
# frontend/src/components/landing/ is NOT swept up by this rule.
/instructions/
/landing/

# ─── Conference paper ────────────────────────────────────────────────────────
# LaTeX sources, benchmarks, and build artifacts for the academic paper. Not
# part of the shipped product and should never be committed.
/FOR CONFERENCE PAPER/

# Working notes aimed at rewriting the paper — they quote reviewer wording and
# our own unpublished framing, so they belong with the paper sources above
# rather than in a repo someone else clones to run the app.
/paper-revision-prompt.md

# ─── Viva / presentation material ────────────────────────────────────────────
# Slide decks and the defense-prep guides we read before a viva. Written for us,
# not for anyone reading the repo, and they describe the project rather than
# building it. Leading slash so it cannot match anything deeper in the tree.
/presentation/

# ─── Tool output / generated artifacts ───────────────────────────────────────
/.kilo/

# ─── Per-developer AI agent config ───────────────────────────────────────────
# Instructions for whichever assistant a given developer happens to drive the
# repo with. They encode one person's tool and workflow, not how the project is
# built or run, so they stay local.
#
# AGENTS.md is the deliberate exception and IS tracked: it is repository policy
# addressed to every agent, not one developer's tool setup.
#
# opencode.json carries a provider API key in plaintext. Ignored so it cannot be
# swept into a commit — rotate the key if it was ever shared.
.clinerules
.clineignore
.claude/settings.json
.claude/settings.local.json
opencode.json

# Pasted assistant transcripts kept for reference. A working log, not source.
/chat with claude/


# ─── Personal test data (never commit real resumes) ──────────────────────────
testresume.pdf
*.resume.pdf
resume3(Ats)-links (1).pdf

# ─── Scratch files ───────────────────────────────────────────────────────────
# "/d" and "/0" are not real files — they are junk left by mistyped shell
# redirects (a stray `> d` or `> 0`). Anchored with a leading slash so they can
# never match a legitimately-named file deeper in the tree.
temp.txt
/d
/0

# Screenshots dropped by the frontend/verify-*.js Playwright checks. They are
# regenerated on every run and are evidence of one run, not source — anchored to
# the frontend root so a deliberately-committed asset under public/ still lands.
/frontend/shot-*.png

# Misspelled duplicate of files already served from frontend/public/
/assets/assests/


# ─── Misc ────────────────────────────────────────────────────────────────────
*.tmp
*.bak
*.swp


